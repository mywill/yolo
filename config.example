# YOLO Project Configuration
# This file is sourced as a bash script by yolo.
# Location: .git/yolo/config
#
# The .git/yolo directory is safe from 'git clean' and works with git worktrees.

# ============================================================================
# HARNESS
# ============================================================================
# Which AI coding harness to run inside the container.
# One of: claude (default), opencode, pi, hermes.
# (codex is planned but not yet enabled in this build of yolo; setting
# HARNESS="codex" will error out at startup with a "planned but not yet
# enabled" message. See SPEC.md §10.)
# Overridden by `yolo --harness=NAME`.

# HARNESS="claude"

# ============================================================================
# VOLUME MOUNTS
# ============================================================================
# Array of volumes to mount into the container.
#
# Syntax options:
#   "~/projects"              -> ~/projects:~/projects:z (1-to-1 mount)
#   "~/projects::ro"          -> ~/projects:~/projects:ro,z (1-to-1 with options)
#   "~/data:/data:z"          -> ~/data:/data:z (explicit mapping)
#
# The shorthand syntax makes it easy to mount directories at the same path
# in both host and container.
YOLO_PODMAN_VOLUMES=(
    # "~/projects"              # Mount ~/projects at same path in container
    # "~/data::ro"              # Mount ~/data read-only at same path
    # "/mnt/storage:/storage:z" # Explicit host:container:options
)

# ============================================================================
# PODMAN OPTIONS
# ============================================================================
# Array of additional options passed to 'podman run'.
# Environment variables, network settings, resource limits, devices, etc.
YOLO_PODMAN_OPTIONS=(
    # "--env=DEBUG=1"
    # "--env=MY_API_KEY=secret"
    # "--network=host"
    # "--cpus=2"
    # "--memory=4g"
)

# ============================================================================
# HARNESS ARGUMENTS
# ============================================================================
# Array of arguments passed to the active harness inside the container.
# Prepended before any args after `--` on the command line, after the
# harness's yolo-mode flag (e.g. --dangerously-skip-permissions).
YOLO_HARNESS_ARGS=(
    # "--model=claude-sonnet-4-6"
    # "--verbose"
)

# Deprecated alias for YOLO_HARNESS_ARGS. If set, contents are merged into
# YOLO_HARNESS_ARGS at startup and a one-time warning is printed.
# YOLO_CLAUDE_ARGS=()

# ============================================================================
# DEFAULT FLAGS
# ============================================================================
# Set default behavior for yolo flags. Command-line options override.

# Enable NVIDIA GPU passthrough by default (requires nvidia-container-toolkit)
# USE_NVIDIA=0

# Git worktree handling mode: ask (default), bind, skip, or error
# WORKTREE_MODE="ask"

# ============================================================================
# USAGE NOTES
# ============================================================================
# - Sourced as bash, so any bash syntax works.
# - Arrays can span multiple lines for readability.
# - Use `+=` to append, `=` to reset.
# - Command-line arguments always take precedence over config.
# - Use --no-config flag to ignore this file entirely.
# - Use --install-config to recreate this template.
